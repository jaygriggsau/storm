# Postgres (Vercel Postgres or any PG-compatible URL)
POSTGRES_URL=postgres://user:password@host:5432/db

# Auth.js
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Email magic-link (Resend)
AUTH_RESEND_KEY=re_xxx
AUTH_RESEND_FROM=Storm the Tower <noreply@example.com>

# GitHub OAuth (optional alternative sign-in)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
